import { Theme } from "theme.slint";
import { Icon } from "icons.slint";
import { MenuItem } from "toolbar-action.slint";

// "Recently modified ▾" / "Name ▾". Rust owns the sort key; this only shows
// the current one and reports the chosen one back.
export component SortControl inherits Rectangle {
    // "modified" or "name".
    in property <string> sort;
    callback sort-changed(string);

    property <string> label: root.sort == "name" ? "Name" : "Recently modified";
    min-width: caption.preferred-width + 44px;
    preferred-width: self.min-width;
    horizontal-stretch: 0;
    min-height: 34px;
    max-height: 34px;
    border-radius: 4px;
    background: touch.has-hover ? Theme.surface-2 : transparent;
    accessible-role: button;
    accessible-label: "Sort by " + root.label;
    accessible-action-default => {
        menu.show();
    }

    caption := Text {
        x: 10px;
        y: 0px;
        height: parent.height;
        text: root.label;
        color: Theme.ink;
        font-size: Theme.text-body;
        vertical-alignment: center;
        accessible-role: none;
    }
    Icon {
        x: parent.width - 26px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        name: "chevron-down";
        stroke: Theme.ink-2;
        stroke-width: 1.6px;
    }
    touch := TouchArea {
        clicked => {
            menu.show();
        }
    }
    menu := PopupWindow {
        x: 0px;
        y: parent.height + 4px;
        width: 190px;
        height: 70px;
        close-policy: close-on-click-outside;
        Rectangle {
            width: parent.width;
            height: parent.height;
            background: Theme.surface;
            border-width: 1px;
            border-color: Theme.rule-strong;
            border-radius: Theme.radius;
            VerticalLayout {
                padding: 4px;
                spacing: 0px;
                MenuItem {
                    text: "Recently modified";
                    clicked => {
                        root.sort-changed("modified");
                        menu.close();
                    }
                }
                MenuItem {
                    text: "Name";
                    clicked => {
                        root.sort-changed("name");
                        menu.close();
                    }
                }
            }
        }
    }
}
